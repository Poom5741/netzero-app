/**
 * Bake-off strategy batch 2 (ticket #96): T4 traditional-CV heuristics and
 * T2 object-detection rules. Pure logic tested via synthetic pixel buffers
 * and canned DETR-shaped invoker output — no network, no fixture files.
 */
import { describe, expect, test } from "vitest";
import { FAIL_SAFE } from "../../src/vision/classifier";
import {
  analyzePixels,
  makeT2DetrRulesStrategy,
  makeT4ColorLinesStrategy,
  T2_DETR_MODEL,
  T2_DETR_RULES,
  T4_COLOR_LINES,
} from "../../src/vision/strategies-cv";

// ---------------------------------------------------------------------------
// Synthetic pixel helpers (RGBA)
// ---------------------------------------------------------------------------

function solidPixels(width: number, height: number, rgb: [number, number, number]) {
  const data = new Uint8Array(width * height * 4);
  for (let i = 0; i < data.length; i += 4) {
    data[i] = rgb[0];
    data[i + 1] = rgb[1];
    data[i + 2] = rgb[2];
    data[i + 3] = 255;
  }
  return { width, height, data };
}

/** Top half in topColor, bottom half in bottomColor. */
function splitPixels(
  width: number,
  height: number,
  topColor: [number, number, number],
  bottomColor: [number, number, number],
) {
  const px = solidPixels(width, height, topColor);
  for (let y = Math.floor(height / 2); y < height; y++) {
    for (let x = 0; x < width; x++) {
      const i = (y * width + x) * 4;
      px.data[i] = bottomColor[0];
      px.data[i + 1] = bottomColor[1];
      px.data[i + 2] = bottomColor[2];
    }
  }
  return px;
}

const BLUE: [number, number, number] = [30, 90, 180]; // bluish water tone
const BROWN: [number, number, number] = [139, 69, 19]; // dry earth/pipe tone

// ---------------------------------------------------------------------------
// T4 pure core — analyzePixels
// ---------------------------------------------------------------------------

describe("t4-color-lines / analyzePixels", () => {
  test("solid water-blue lower half leans flooded", () => {
    const r = analyzePixels(splitPixels(64, 64, BROWN, BLUE));
    expect(r.validity).toBe("valid");
    expect(r.water_state).toBe("flooded");
    expect(r.confidence).toBeGreaterThan(0.5);
  });

  test("fully blue image leans flooded with high confidence", () => {
    const r = analyzePixels(solidPixels(64, 64, BLUE));
    expect(r.validity).toBe("valid");
    expect(r.water_state).toBe("flooded");
    expect(r.confidence).toBeGreaterThan(0.8);
  });

  test("uniform brown leans dry with moderate confidence", () => {
    const r = analyzePixels(solidPixels(64, 64, BROWN));
    expect(r.validity).toBe("valid");
    expect(r.water_state).toBe("dry");
    expect(r.confidence).toBeGreaterThan(0.5);
    expect(r.confidence).toBeLessThanOrEqual(0.75);
  });

  test("near-black image is invalid low-quality", () => {
    const r = analyzePixels(solidPixels(64, 64, [5, 5, 5]));
    expect(r.validity).toBe("invalid");
    expect(r.water_state).toBe("not_applicable");
    expect(r.confidence).toBeLessThan(0.3);
  });

  test("tiny resolution is invalid", () => {
    const r = analyzePixels(solidPixels(16, 16, BROWN));
    expect(r.validity).toBe("invalid");
    expect(r.confidence).toBeLessThan(0.3);
  });

  test("green vegetation-only scene is invalid (no pipe evidence)", () => {
    const r = analyzePixels(solidPixels(64, 64, [40, 140, 40]));
    expect(r.validity).toBe("invalid");
  });

  test("deterministic: same input twice gives identical result", () => {
    const px = splitPixels(64, 64, BROWN, BLUE);
    expect(JSON.stringify(analyzePixels(px))).toBe(JSON.stringify(analyzePixels(px)));
  });

  test("thresholds are overrideable (waterFracMin flips flooded to dry)", () => {
    // Water covers only the left half of the lower region -> lowerWaterFrac ~0.5.
    const px = solidPixels(64, 64, BROWN);
    for (let y = 32; y < 64; y++) {
      for (let x = 0; x < 32; x++) {
        const i = (y * 64 + x) * 4;
        px.data[i] = BLUE[0];
        px.data[i + 1] = BLUE[1];
        px.data[i + 2] = BLUE[2];
      }
    }
    expect(analyzePixels(px).water_state).toBe("flooded");
    expect(analyzePixels(px, { waterFracMin: 0.999 }).water_state).toBe("dry");
  });
});

describe("t4-color-lines factory", () => {
  test("exposes bake-off name constant and callable strategy", async () => {
    expect(T4_COLOR_LINES).toBe("t4-color-lines");
    const s = makeT4ColorLinesStrategy();
    expect(typeof s).toBe("function");
  });

  test("decodes a real JPEG buffer end-to-end", async () => {
    // Encode synthetic pixels to actual JPEG bytes — proves the decoder path.
    const jpeg = await import("jpeg-js");
    const w = 64;
    const h = 64;
    const px = splitPixels(w, h, BROWN, BLUE);
    const encoded = jpeg.encode({ data: px.data, width: w, height: h }, 90);
    const result = await makeT4ColorLinesStrategy()(
      encoded.data.buffer.slice(
        encoded.data.byteOffset,
        encoded.data.byteOffset + encoded.data.byteLength,
      ) as ArrayBuffer,
    );
    expect(result.validity).toBe("valid");
    expect(result.water_state).toBe("flooded");
  });

  test("garbage bytes fail safe instead of throwing", async () => {
    const result = await makeT4ColorLinesStrategy()(new ArrayBuffer(8));
    expect(result).toEqual(FAIL_SAFE);
  });
});

// ---------------------------------------------------------------------------
// T2 DETR rules
// ---------------------------------------------------------------------------

type DetrPrediction = { label: string; score: number; box: unknown };

function detr(predictions: DetrPrediction[] | unknown) {
  return { predictions };
}

const PIPE_BOX = [10, 10, 50, 50]; // [x_min, y_min, x_max, y_max]
const WATER_BOX_OVERLAP = [15, 30, 45, 60]; // overlaps pipe's lower area
const WATER_BOX_AWAY = [200, 200, 240, 240];

describe("t2-detr-rules", () => {
  const pipeAndWater: DetrPrediction[] = [
    { label: "cup", score: 0.9, box: PIPE_BOX },
    { label: "bowl", score: 0.8, box: WATER_BOX_OVERLAP },
  ];

  test("name constant matches ticket prefix", () => {
    expect(T2_DETR_RULES).toBe("t2-detr-rules");
    expect(T2_DETR_MODEL).toBe("@cf/facebook/detr-resnet-50");
  });

  test("pipe candidate + overlapping bowl-like detection -> flooded", async () => {
    const s = makeT2DetrRulesStrategy({
      ai: async () => detr(pipeAndWater),
    });
    const r = await s(new ArrayBuffer(0));
    expect(r.validity).toBe("valid");
    expect(r.water_state).toBe("flooded");
    expect(r.confidence).toBeGreaterThan(0.6);
  });

  test("object-box variant of DETR output maps the same way", async () => {
    const s = makeT2DetrRulesStrategy({
      ai: async () =>
        detr([
          { label: "cup", score: 0.9, box: { x_min: 10, y_min: 10, x_max: 50, y_max: 50 } },
          { label: "bowl", score: 0.8, box: { x_min: 15, y_min: 30, x_max: 45, y_max: 60 } },
        ]),
    });
    const r = await s(new ArrayBuffer(0));
    expect(r.water_state).toBe("flooded");
  });

  test("pipe present without water overlap -> dry at moderate confidence", async () => {
    const s = makeT2DetrRulesStrategy({
      ai: async () =>
        detr([
          { label: "bottle", score: 0.85, box: PIPE_BOX },
          { label: "bowl", score: 0.8, box: WATER_BOX_AWAY },
        ]),
    });
    const r = await s(new ArrayBuffer(0));
    expect(r.validity).toBe("valid");
    expect(r.water_state).toBe("dry");
    expect(r.confidence).toBeGreaterThan(0.4);
    expect(r.confidence).toBeLessThan(0.7);
  });

  test("no plausible pipe-candidate class -> invalid", async () => {
    const s = makeT2DetrRulesStrategy({
      ai: async () => detr([{ label: "person", score: 0.99, box: PIPE_BOX }]),
    });
    const r = await s(new ArrayBuffer(0));
    expect(r.validity).toBe("invalid");
    expect(r.water_state).toBe("not_applicable");
  });

  test("pipe candidate below score threshold -> invalid", async () => {
    const s = makeT2DetrRulesStrategy(
      { ai: async () => detr([{ label: "cup", score: 0.49, box: PIPE_BOX }]) },
      { pipeScoreMin: 0.5 },
    );
    const r = await s(new ArrayBuffer(0));
    expect(r.validity).toBe("invalid");
  });

  test("empty predictions -> invalid", async () => {
    const s = makeT2DetrRulesStrategy({ ai: async () => detr([]) });
    const r = await s(new ArrayBuffer(0));
    expect(r.validity).toBe("invalid");
  });

  test("malformed invoker output fails safe", async () => {
    for (const bad of ["not json", detr("oops"), {}, null, 42]) {
      const s = makeT2DetrRulesStrategy({ ai: async () => bad });
      expect(await s(new ArrayBuffer(0))).toEqual(FAIL_SAFE);
    }
  });

  test("throwing invoker fails safe", async () => {
    const s = makeT2DetrRulesStrategy({
      ai: async () => {
        throw new Error("network down");
      },
    });
    expect(await s(new ArrayBuffer(0))).toEqual(FAIL_SAFE);
  });

  test("waterScoreMin override can suppress flooding", async () => {
    const s = makeT2DetrRulesStrategy(
      { ai: async () => detr(pipeAndWater) },
      { waterScoreMin: 0.95 },
    );
    const r = await s(new ArrayBuffer(0));
    expect(r.water_state).toBe("dry");
  });
});
