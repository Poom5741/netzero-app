/**
 * CLI: generate data/labeled-pipes/split.json from manifest.json.
 * Deterministic (mulberry32 seed 42, stratified 70/30) — run:
 *   bun run scripts/make-split.ts [--data-dir data/labeled-pipes]
 */
import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { type BakeoffManifest, type PipeLabel } from "../src/vision/bakeoff";
import { makeSplit } from "../src/vision/split";

const argIdx = process.argv.indexOf("--data-dir");
const dataDir = argIdx > -1 ? (process.argv[argIdx + 1] ?? "data/labeled-pipes") : "data/labeled-pipes";

const manifest = JSON.parse(
  readFileSync(join(dataDir, "manifest.json"), "utf8"),
) as BakeoffManifest;
const split = makeSplit(manifest);

writeFileSync(join(dataDir, "split.json"), `${JSON.stringify(split, null, 2)}\n`);
const perClass = (c: Record<PipeLabel, number>) =>
  `flooded=${c.flooded} dry=${c.dry} invalid=${c.invalid}`;
console.log(`split.json written to ${dataDir}`);
console.log(`train (${split.train.length}): ${perClass(split.counts.train)}`);
console.log(`holdout (${split.holdout.length}): ${perClass(split.counts.holdout)}`);
