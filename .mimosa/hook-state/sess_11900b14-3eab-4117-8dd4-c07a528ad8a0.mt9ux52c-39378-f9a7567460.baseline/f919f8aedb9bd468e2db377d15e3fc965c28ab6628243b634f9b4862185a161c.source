/**
 * Deterministic stratified train/hold-out split for the labeled pipe dataset
 * (issue #97). Every bake-off strategy trains on `train` and is scored on
 * `holdout`. Same seed -> byte-identical split, so data/ can stay gitignored.
 */
import type { BakeoffManifest, PipeLabel } from "./bakeoff";

export const SPLIT_SEED = 42;
export const TRAIN_RATIO = 0.7;
export const SPLIT_VERSION = 1;

export interface SplitEntry {
  path: string;
  label: PipeLabel;
}

export interface LabeledSplit {
  version: number;
  seed: number;
  trainRatio: number;
  counts: {
    train: Record<PipeLabel, number>;
    holdout: Record<PipeLabel, number>;
  };
  train: SplitEntry[];
  holdout: SplitEntry[];
}

/** Mulberry32 PRNG: tiny, seeded, deterministic across JS engines. */
export function mulberry32(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a += 0x6d2b79f5;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const LABELS: PipeLabel[] = ["flooded", "dry", "invalid"];

/**
 * Shuffles each class independently (Fisher-Yates over the seeded PRNG), then
 * takes round(n * trainRatio) per class as train, rest as holdout — so every
 * class lands within ±1 of the exact ratio regardless of class imbalance.
 */
export function makeSplit(
  manifest: BakeoffManifest,
  opts?: { seed?: number; trainRatio?: number },
): LabeledSplit {
  const seed = opts?.seed ?? SPLIT_SEED;
  const ratio = opts?.trainRatio ?? TRAIN_RATIO;
  const rand = mulberry32(seed);

  const train: SplitEntry[] = [];
  const holdout: SplitEntry[] = [];
  const counts = {
    train: { flooded: 0, dry: 0, invalid: 0 } as Record<PipeLabel, number>,
    holdout: { flooded: 0, dry: 0, invalid: 0 } as Record<PipeLabel, number>,
  };

  for (const label of LABELS) {
    const pool = manifest.images.filter((e) => e.label === label);
    // Sort-by-seeded-key shuffle: deterministic, assertion-free under
    // noUncheckedIndexedAccess; bias irrelevant for a train/holdout cut.
    const shuffled = pool
      .map((e) => ({ e, key: rand() }))
      .sort((a, b) => a.key - b.key)
      .map(({ e }) => e);
    const nTrain = Math.round(shuffled.length * ratio);
    for (const [i, e] of shuffled.entries()) {
      const target = i < nTrain ? train : holdout;
      target.push(e);
      counts[i < nTrain ? "train" : "holdout"][label] += 1;
    }
  }

  return { version: SPLIT_VERSION, seed, trainRatio: ratio, counts, train, holdout };
}
