  "plot_code",
  "area_rai",
  "farmer_name",
  "province",
  "season_id",
  "version",
  "status",
  "total_offset_tco2e",
  "sf_w",
  "sf_p",
  "sf_o",
  "nitrogen_total_kg_per_rai",
  "baseline_ch4",
  "project_ch4",
  "baseline_n2o",
  "project_n2o",
  "baseline_co2",
  "project_co2",
  "burning_emissions",
  "verification_label"
];
function estimatesToCSV(rows) {
  const header = CSV_HEADERS.join(",");
  const lines = rows.map((row) => CSV_HEADERS.map((h) => String(row[h] ?? "")).join(","));
  return [header, ...lines].join("\n");
}
