async function handleFlowApi(ctx) {
  const { state } = ctx;
  switch (state) {
    case "welcome":
      return handleWelcomeApi(ctx);
    case "phone":
      return handlePhoneApi(ctx);
    case "pending":
      return handlePendingApi(ctx);
    case "select_plot":
      return handleSelectPlotApi(ctx);
    case "confirm_draft":
      return handleConfirmDraftApi(ctx);
    case "chat":
    default:
      return handleChatApi(ctx);
  }
}
