    return c.html(renderLoginPage("Email and password are required"), 400);
  }
  const user = await c.env.DB.prepare(
    "SELECT id, email, password_hash, role FROM users WHERE email = ?"
  ).bind(email).first();
  if (!user) {
    return c.html(renderLoginPage("Invalid credentials"), 401);
  }
  const { verifyPassword: verifyPassword2 } = await Promise.resolve().then(() => (init_password(), password_exports));
  const valid = await verifyPassword2(password, user.password_hash);
