        f.addr_province AS province,
        f.addr_district AS district,
        ce.season_id,
        si.water_management,
        ce.status AS estimate_status,
        ce.total_offset_tco2e,
        ce.sf_w,
        ce.sf_p,
        ce.sf_o,
        ce.nitrogen_total_kg_per_rai
      FROM plots p
      JOIN farmers f ON f.id = p.farmer_id
      LEFT JOIN carbon_estimates ce
        ON ce.plot_id = p.id
