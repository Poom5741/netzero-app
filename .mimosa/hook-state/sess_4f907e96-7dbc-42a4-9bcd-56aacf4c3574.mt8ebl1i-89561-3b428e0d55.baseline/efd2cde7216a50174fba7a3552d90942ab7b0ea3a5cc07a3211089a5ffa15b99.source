  if (!session) return c.json({ error: "Unauthorized" }, 401);
  const db = c.env.DB;
  const photoId = c.req.param("photoId");
  const body = await c.req.json();
  const result = await reviewPhoto(db, photoId, body.status, body.reason || "");
