  for (const row of rows) {
    const province = row.province ?? "Unknown";
    const existing = map.get(province) ?? [];
    existing.push(row);
    map.set(province, existing);
  }
  return Array.from(map.entries()).map(([province, plots]) => ({
    province,
    plots
  }));
}
