// src/export/estimates.ts
init_checked_fetch();
init_modules_watch_stub();
var NOT_VERIFIED = "estimate \u2014 not yet verified";
async function getAllEstimates(db) {
  const { results } = await db.prepare(
    `SELECT
        ce.plot_id,
        p.plot_code,
        p.area_rai,
        f.full_name AS farmer_name,
        f.addr_province AS province,
        ce.season_id,
        ce.version,
        ce.status,
        ce.total_offset_tco2e,
        ce.sf_w,
        ce.sf_p,
        ce.sf_o,
        ce.nitrogen_total_kg_per_rai,
        ce.baseline_ch4,
        ce.project_ch4,
        ce.baseline_n2o,
        ce.project_n2o,
        ce.baseline_co2,
        ce.project_co2,
        ce.burning_emissions
      FROM carbon_estimates ce
      JOIN plots p ON p.id = ce.plot_id
      JOIN farmers f ON f.id = p.farmer_id
      ORDER BY f.addr_province, p.plot_code, ce.season_id, ce.version`
  ).bind().all();
  const rows = results ?? [];
  return rows.map((row) => ({ ...row, verification_label: NOT_VERIFIED }));
}
