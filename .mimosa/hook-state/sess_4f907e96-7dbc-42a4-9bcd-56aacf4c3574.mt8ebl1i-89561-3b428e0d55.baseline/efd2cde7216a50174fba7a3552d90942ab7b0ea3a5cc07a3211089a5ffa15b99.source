  }
  const plotList = plots.results.map((p, i) => `${i + 1}. ${p.plot_code} (${p.area_rai} \u0E44\u0E23\u0E48)`).join("\n");
  return { reply: `\u{1F4CB} \u0E41\u0E1B\u0E25\u0E07\u0E19\u0E32\u0E02\u0E2D\u0E07\u0E17\u0E48\u0E32\u0E19:

${plotList}

\u0E1E\u0E34\u0E21\u0E1E\u0E4C\u0E2B\u0E21\u0E32\u0E22\u0E40\u0E25\u0E02\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E25\u0E37\u0E2D\u0E01\u0E41\u0E1B\u0E25\u0E07`, newState: "select_plot" };
}
__name(handleSelectPlotApi, "handleSelectPlotApi");
async function handleConfirmDraftApi(ctx) {
