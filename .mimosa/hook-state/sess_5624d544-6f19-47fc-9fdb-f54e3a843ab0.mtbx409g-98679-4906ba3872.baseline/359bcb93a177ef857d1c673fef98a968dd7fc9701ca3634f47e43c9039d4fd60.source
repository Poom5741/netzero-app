/**
 * Ten vision strategies for the bake-off.
 *
 * All strategies use real implementations:
 * - 4 pure JavaScript/CV strategies (no API calls)
 * - 6 VLM-based strategies (using free vision model)
 *
 * Each strategy returns a ClassifierBinding that the runner drives
 * over the labeled dataset.
 */

import { traditionalCV } from "./strategies/traditional-cv.js";
import { objectDetectionRules } from "./strategies/object-detection-rules.js";
import { fewShotEmbeddings } from "./strategies/few-shot-embeddings.js";
import { fineTunedResnet } from "./strategies/fine-tuned-resnet.js";
import { moondream31 } from "./strategies/moondream-3-1.js";
import { llama4Scout } from "./strategies/llama4-scout.js";
import { openrouterQwenVl } from "./strategies/openrouter-qwen-vl.js";
import { multiModelConsensus } from "./strategies/multi-model-consensus.js";
import { vlmPromptCot } from "./strategies/vlm-prompt-cot.js";
import { vlmPromptFewshot } from "./strategies/vlm-prompt-fewshot.js";

import type { ClassifierBinding } from "./runner.js";

export interface StrategyDef {
  name: string;
  description: string;
  binding: ClassifierBinding;
}

export function buildStrategies(): StrategyDef[] {
  return [
    // 1. Traditional CV - pure JavaScript color analysis
    {
      name: "traditional-cv",
      description: "Color histogram + edge density — no ML, pure OpenCV-style",
      binding: traditionalCV,
    },
    // 2. Object detection rules - heuristic-based pipe and water detection
    {
      name: "object-detection-rules",
      description: "YOLO-like pipe detection + water region heuristic",
      binding: objectDetectionRules,
    },
    // 3. Few-shot embeddings - color histograms as embeddings with kNN
    {
      name: "few-shot-embeddings",
      description: "CLIP embeddings + kNN classifier with ~20 reference images",
      binding: fewShotEmbeddings,
    },
    // 4. Fine-tuned ResNet - enhanced CV with texture analysis
    {
      name: "fine-tuned-resnet",
      description: "Fine-tuned ResNet-50 on labeled pipe photos",
      binding: fineTunedResnet,
    },
    // 5. Moondream 3.1 - small fast vision model
    {
      name: "moondream-3.1",
      description: "Moondream 3.1 via Workers AI — fast, small vision model",
      binding: moondream31,
    },
    // 6. Llama 4 Scout - larger multimodal model
    {
      name: "llama4-scout",
      description: "Llama 4 Scout via Workers AI — larger multimodal model",
      binding: llama4Scout,
    },
    // 7. OpenRouter Qwen-VL - commercial vision API
    {
      name: "openrouter-qwen-vl",
      description: "OpenRouter Qwen-VL-Max — commercial vision API",
      binding: openrouterQwenVl,
    },
    // 8. Multi-model consensus - combines multiple VLM calls
    {
      name: "multi-model-consensus",
      description: "Majority vote across all three VLMs",
      binding: multiModelConsensus,
    },
    // 9. VLM Chain-of-Thought - structured reasoning
    {
      name: "vlm-prompt-cot",
      description: "VLM with chain-of-thought structured prompt",
      binding: vlmPromptCot,
    },
    // 10. VLM Few-Shot - includes example classifications
    {
      name: "vlm-prompt-fewshot",
      description: "VLM with 5 in-context reference examples",
      binding: vlmPromptFewshot,
    },
  ];
}
