    gender: "female",
    addr_province: "เชียงใหม่",
    addr_district: "สันทราย",
    addr_subdistrict: "สันทรายหลวง",
    addr_village: "หมู่ 2",
  },
];

const DEMO_PLOTS = [
  {
    id: "demo-plot-1",
    farmer_id: "demo-farmer-1",
    plot_code: "P-DMO-001",
    deed_no: "12345",
