// netzero-frontend worker: static SPA assets + API proxy to the STAGING
// backend (netzero-carbon-poc). Corrected 2026-10-05: the previous assets-only
// config was stale; the live worker carried BACKEND -> netzero-carbon-poc-staging
// (the DEV backend), which served pre-F1 code to the 017 sponsor portal.
// run_worker_first lists exactly the API seams; page routes (/sponsor,
// /sponsor/login, /sponsor/areas, /sponsor/reports) stay on assets so the
// SPA shell serves them.
{
  "name": "netzero-frontend",
  "main": "functions/_worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/login",
      "/logout",
      "/redirect",
      "/sponsor-login",
      "/evidence/*"
    ]
  },
  "services": [
    { "binding": "BACKEND", "service": "netzero-carbon-poc" }
  ]
}
