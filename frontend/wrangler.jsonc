// Static LIFF frontend served as a Workers assets-only project.
// API calls go directly to the backend worker via NEXT_PUBLIC_API_BASE (baked at build time).
{
  "name": "netzero-frontend",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./out",
    "not_found_handling": "single-page-application"
  }
}
